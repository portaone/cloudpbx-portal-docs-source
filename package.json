    "screenshots:billing": "playwright test --config=screenshot-gen/playwright.config.ts capture-billing",
    "screenshots:my-profile": "playwright test --config=screenshot-gen/playwright.config.ts capture-my-profile",
    "screenshots:portal-users": "playwright test --config=screenshot-gen/playwright.config.ts capture-portal-users",
    "screenshots:company-info": "playwright test --config=screenshot-gen/playwright.config.ts capture-company-info",
    "screenshots:extensions": "playwright test --config=screenshot-gen/playwright.config.ts capture-extensions",
    "screenshots:ring-groups": "playwright test --config=screenshot-gen/playwright.config.ts capture-ring-groups",
    "screenshots:fax-mailboxes": "playwright test --config=screenshot-gen/playwright.config.ts capture-fax-mailboxes",
    "screenshots:call-parking-slots": "playwright test --config=screenshot-gen/playwright.config.ts capture-call-parking-slots",
    "screenshots:call-settings": "playwright test --config=screenshot-gen/playwright.config.ts capture-call-settings",
    "screenshots:call-activity": "playwright test --config=screenshot-gen/playwright.config.ts capture-call-activity"
